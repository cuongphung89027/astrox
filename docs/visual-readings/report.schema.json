{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:astrox:visual-reading:v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "module", "serviceId", "locale", "title", "summary", "chapters"],
  "properties": {
    "schemaVersion": {"const": "astrox.visual-reading.v1"},
    "module": {"enum": ["tuvi", "zodiac", "batu", "numerology", "compat"]},
    "serviceId": {"type": "string", "pattern": "^(tuvi|zodiac|batu|numerology|compat)--[a-z0-9-]+(?:--[a-z0-9-]+)?$"},
    "locale": {"enum": ["vi", "en"]},
    "title": {"type": "string", "minLength": 1, "maxLength": 72},
    "summary": {"type": "string", "minLength": 1, "maxLength": 180},
    "chapters": {"type": "array", "minItems": 2, "maxItems": 4, "items": {"$ref": "#/definitions/chapter"}}
  },
  "definitions": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9._-]{0,79}$"},
    "factIds": {"type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true, "items": {"$ref": "#/definitions/id"}},
    "visual": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "factIds"],
      "properties": {
        "kind": {"enum": ["trait-map", "trait-spectrum", "balance-path", "factor-map", "action-path", "palace-map", "natal-map", "element-flow", "timeline", "pair-map"]},
        "factIds": {"$ref": "#/definitions/factIds"},
        "signals": {"type":"array","minItems":1,"maxItems":4,"items":{"type":"object","additionalProperties":false,"required":["axisId","lean","insightId"],"properties":{"axisId":{"$ref":"#/definitions/id"},"lean":{"enum":["left","balanced","right","unknown"]},"insightId":{"$ref":"#/definitions/id"}}}}
      },
      "allOf": [{"if":{"properties":{"kind":{"const":"trait-spectrum"}}},"then":{"required":["signals"]},"else":{"not":{"required":["signals"]}}}]
    },
    "insight": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "role", "label", "summary", "detail", "rationale", "action", "sourceFactIds"],
      "properties": {
        "id": {"$ref": "#/definitions/id"},
        "role": {"enum": ["strength", "balance", "context", "action"]},
        "label": {"type": "string", "minLength": 1, "maxLength": 44},
        "summary": {"type": "string", "minLength": 1, "maxLength": 140},
        "detail": {"type": "string", "minLength": 1, "maxLength": 520},
        "rationale": {"type": "string", "minLength": 1, "maxLength": 180},
        "action": {"type": "string", "minLength": 1, "maxLength": 140},
        "sourceFactIds": {"$ref": "#/definitions/factIds"}
      }
    },
    "chapter": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "title", "summary", "visual", "insights"],
      "properties": {
        "id": {"$ref": "#/definitions/id"},
        "title": {"type": "string", "minLength": 1, "maxLength": 64},
        "summary": {"type": "string", "minLength": 1, "maxLength": 160},
        "visual": {"$ref": "#/definitions/visual"},
        "insights": {"type": "array", "minItems": 1, "maxItems": 4, "items": {"$ref": "#/definitions/insight"}}
      }
    }
  }
}
